{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "common-ground-phygital",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	// Every request that isn't a 304 touches D1, and D1 has ONE primary. Without
	// this the Worker runs at the colo nearest the phone and pays a round trip
	// per read and up to three per compare-and-swap write; smart placement runs
	// it next to the database instead. Takes a few hundred requests to learn.
	"placement": { "mode": "smart" },
	// Request logs + traces in the dashboard. This app's failure mode is latency,
	// not errors, and without this there is nothing to look at after the session.
	"observability": { "enabled": true },
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Workers AI — Llama 3 brief narrative (no key; uses account AI binding)
	"ai": {
		"binding": "AI"
	},
	// D1 — single strongly-consistent store for the one LIVE room.
	// Replaces the per-colo Cache API (which split state across colos).
	"d1_databases": [
		{
			"binding": "common_ground_db",
			"database_name": "common-ground-db",
			"database_id": "7c40c4ce-932b-450c-97f4-3daab7907375"
		}
	]
	// Optional: wrangler secret put FAL_API_KEY  (finale workspace image)
}
